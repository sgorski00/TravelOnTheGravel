POSTGRES_DB=travelonthegravel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

API_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@travelonthegravel.local
MAILPIT_UI_PORT=8025
APP_RESET_PASSWORD_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL=1h

JWT_SECRET=change-me-to-your-own-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=30d

HTTP_USER_AGENT=TravelOnTheGravel (https://github.com/sgorski00/TravelOnTheGravel)

NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT=5s

OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT=10s

# First admin account (optional)
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
